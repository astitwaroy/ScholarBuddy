# Postgres with the pgvector extension (Neon works out of the box)
DATABASE_URL=postgresql://dev:dev@localhost:5432/schemes
# Free key from https://aistudio.google.com/apikey: used for embeddings and answers.
# Without it the app still works: keyword search + answers quoted straight from the documents.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# Or use any OpenAI-compatible API (e.g. Groq) for answers:
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=llama-3.3-70b-versatile
AUTO_INGEST=true
# Enables /api/admin/ingest and /api/admin/eval (send it as the X-Admin-Token header)
ADMIN_TOKEN=
